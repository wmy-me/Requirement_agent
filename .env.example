# 需求管理 Agent —— 环境变量模板
#
# 用法：cp .env.example .env，然后逐项填写。
# 本文件不含任何真实密钥，请勿把填好的 .env 提交进版本库（.gitignore 已忽略）。
#
# 键名与 src/requirement_agent/config/settings.py 的字段别名一一对应；
# 留空的键会走 settings.py 里的默认值，标了「必填」的键缺失会导致启动/调用失败。

# ── 应用 ──────────────────────────────────────────────────────────────
APP_ENV=dev
APP_PORT=8888
# 业务展示时区。数据库统一以 UTC 存储，前端按此转换。
DISPLAY_TIMEZONE=Asia/Shanghai

# ── PostgreSQL（必填）────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=requirement_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── MinIO 对象存储（对话附件 / 文档）──────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=requirement-attachments

# ── API 鉴权与身份 ───────────────────────────────────────────────────
# 【推荐】多 token → 角色：每个调用方拿自己的 token，角色由服务端解析、不可伪造。
# 角色取值：admin（全部权限）/ reviewer（可裁决、不可回滚）/ system_worker（可运维、不可裁决）
#   六类权限：read（全部 GET）/ analyze（分析与会话）/ submit（提交待审）
#            / review（人工裁决）/ revert（回滚）/ ops（运维）
# ⚠️ 一个 token 都不配 = **全部受保护端点 401**（默认拒绝，不是默认放行）。
# 例：API_AUTH_TOKENS={"tok-admin-xxx":"admin","tok-review-xxx":"reviewer"}
API_AUTH_TOKENS=

# 【兼容】旧的单 token 入口：配了它就等同于一个 admin token。
# 既有部署与全部既有测试依赖它；新部署请用 API_AUTH_TOKENS。
API_AUTH_TOKEN=

API_ACTOR_ID=api-operator

# 【可选】会**发给前端页面**的那个 token（见 api/app.py 的 _write_ui_config）。
# 留空时回退：API_AUTH_TOKEN → API_AUTH_TOKENS 的第一个。
# 想让页面只拿到受限凭证时，在 API_AUTH_TOKENS 里为前端配一个 reviewer
# （能看/能提交/能裁决，**不能回滚、不能运维**），再把这里指过去：
#   API_AUTH_TOKENS={"<admin token>":"admin","<前端 token>":"reviewer"}
#   UI_EXPOSED_TOKEN=<前端 token>
UI_EXPOSED_TOKEN=

# 豁免鉴权的路径（见 src/requirement_agent/api/auth.py）：
#   飞书 webhook（走飞书自身验签）/ 探活 /static /ui /docs /openapi.json

# ── LLM chat provider ────────────────────────────────────────────────
# 二选一：deepseek | openai。下面两组只有被选中的那组生效。
LLM_PROVIDER=deepseek

# DeepSeek（LLM_PROVIDER=deepseek 时生效）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容端点（LLM_PROVIDER=openai 时生效；也可指向任意兼容网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── LLM 请求调参（可选）──────────────────────────────────────────────
# temperature：默认不设置 = 请求体不带该字段（与历史行为一致）。
# 需要确定性、可复现的输出时取消下一行注释并设为 0。
#LLM_TEMPERATURE=0
# 非流式与 embedding 请求的总超时（秒）。
# 长文档抽取实测约 28s，留足余量避免超时后静默降级到启发式。
LLM_TIMEOUT_SECONDS=60
# 流式请求的 read 超时（秒）：首字节之后每段增量的等待上限
LLM_STREAM_READ_TIMEOUT_SECONDS=120
# 可恢复错误（网络异常 / 408,409,425,429,5xx）的最大重试次数；0 = 不重试
LLM_MAX_RETRIES=2
# 重试退避基数（秒）：第 n 次重试等待 base * 2**n 并叠加抖动
LLM_RETRY_BACKOFF_SECONDS=0.5

# ── Embedding（独立网关，与 chat provider 解耦）───────────────────────
# 必要性：chat provider 是 deepseek 时它没有 /embeddings 端点，必须单独配。
# 若只配 chat 而不配这里，embed() 会回落到 chat base_url 并 404。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 必须与数据库向量列维度一致：三张表（requirement_embedding / document_chunk /
# memory_note）经 006 迁移后均为 vector(4096)。
EMBEDDING_DIMENSION=4096

# ── 任务级模型路由（B3.1）──────────────────────────────────────────────
# 让不同任务用不同模型，并给每个任务配备用链。JSON；
# task_type 取值：extract / analyze / risk / narrative / embedding / vision。
#
# ⚠️ **留空 = 全部走上面的全局 LLM_PROVIDER + *_MODEL**，行为与 B3.1 之前
# 完全一致。只有想给某个任务单独指定模型时才填。
#
# 例：
# MODEL_ROUTES={"risk": {"provider": "deepseek", "model": "deepseek-reasoner"},
#               "analyze": {"provider": "deepseek", "model": "deepseek-chat",
#                           "fallbacks": [{"provider": "openai", "model": "gpt-4o-mini"}]}}
#
# ⚠️ provider 只支持 deepseek / openai。拼错的名字不会报错，但会**退到全局配置**
# 并出现在 ModelRegistry.unrecognized() 里 —— 别指望拼错了才发现。
MODEL_ROUTES=

# ── 相似度判定标尺（B4）────────────────────────────────────────────────
# ⚠️ **不要手改下面四个数** —— 它们由实测得来，出处是
#   python -m scripts.calibrate_similarity --write --print-env
# 报告落在 docs/baseline/similarity_calibration_<model>_<date>.json。
#
# 判定是**两把锁**：relevance（全局距离，由 baseline 换算）**且**
# contrast（本次查询内的突出度）。为什么必须是两把 ——
# 本模型的余弦分不开「同能力异对象」与「真重复」（红区 P95 0.9496 >
# 真重复 P05 0.8948），只有落差能分。详见 src/requirement_agent/domain/similarity_scale.py。
#
# 换 embedding 模型后**必须重跑校准**：这四个数只对 SIMILARITY_CALIBRATION_MODEL
# 那个模型有效，换了不会报错，只会静默失准。settings.similarity_calibration_is_stale()
# 会检出并在检索记录里标 stale。
SIMILARITY_BASELINE=0.7273
SIMILARITY_NOISE_CEILING=0.8120
SIMILARITY_CONTRAST_DUPLICATE=0.1385
SIMILARITY_CONTRAST_RELATED=0.0747
SIMILARITY_CALIBRATION_MODEL=Doubao-embedding
SIMILARITY_CALIBRATION_SOURCE=docs/baseline/similarity_calibration_Doubao-embedding_20260917.json

# 分析图里检索的候选条数。**不是越大越好**：它决定 contrast 统计的样本量，
# 而 contrast 取中位数 —— 原先写死 5 时中位数只用 3~4 个数，噪声大到
# 同一条真重复两次走查会分别落到 related 与 duplicate。上限受
# RequirementQueryService.MAX_SEARCH_LIMIT 约束。
SIMILARITY_RECALL_LIMIT=10

# 分析图检索时要不要按渠道过滤。off / soft / hard，默认 soft。
#   off  —— 完全不传 filters，与接线前逐字节一致（对照与回滚用）
#   soft —— **不删候选**，只给每条附「与本条来源同渠道吗」（默认）
#   hard —— 真过滤。⚠️ 只对显式调用方有意义，分析路径基本不该用：
#           实测四个可过滤维度没一个能硬过滤 ——
#           · department / sensitivity_level：库里 12/12 全 NULL → 返回 0 条候选
#             → analyze 判「独立」→ 真重复被静默入库（项目最怕的场景）
#           · source_type：12/12 全 'web'，今天空操作；飞书流量进来后会藏掉跨渠道重复
#           · business_domain：有值，但库里**唯一那条真实关系两端 domain 不同**
#             （门店巡检 workflow ↔ 报表导出 report），硬过滤会把它丢掉
# 证据与反例见 tests/integration/test_retrieval_metadata.py 末尾。
SIMILARITY_FILTER_MODE=soft

# ── 飞书渠道（事件订阅）──────────────────────────────────────────────
# verification_token 与 encrypt_key **至少配一个**，否则 Webhook 端点会拒绝所有请求；
# 两者都配时，签名校验与 token 校验都会执行（推荐）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 应用后台「事件与回调 → 加密策略」里的 Verification Token
FEISHU_VERIFICATION_TOKEN=
# 配置后飞书回调变为密文（AES-256-CBC），并强制要求签名校验
FEISHU_ENCRYPT_KEY=

# ── 后台 outbox 消费循环 ─────────────────────────────────────────────
# 认领并执行 embedding 同步 / 文档分片 / 渠道需求分析三类事件。
#
# 两种形态（B5 起）：
#   独立 Worker（推荐）：python -m requirement_agent.workers
#   API 内嵌（兼容）  ：API 进程 lifespan 里的线程
# 两者由**同一个开关**控制；**同时跑是安全的**（领取用 FOR UPDATE SKIP LOCKED，
# 各领一部分、不会重复处理）。推荐生产形态：独立 Worker 跑 + API 侧设 false。
OUTBOX_CONSUMER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_POLL_BATCH=50
# processing 超过这个时长仍未收尾的事件，视为消费者崩溃、可被重领
OUTBOX_STALE_TIMEOUT_SECONDS=300
# 失败重试的退避（B5）：第 n 次失败后等 base * 2^(n-1)，封顶 max。
# 此前是「失败立刻回 pending」，3 次重试全挤在 ~15 秒里，对瞬时故障几乎等于不重试。
OUTBOX_RETRY_BACKOFF_SECONDS=30
OUTBOX_RETRY_MAX_BACKOFF_SECONDS=600

# 对话运行的「僵尸」阈值（秒）。同一对话只允许一个活跃运行，而进程中断留下的
# running run 不会自己收尾——超过这个时长会被判为 failed，让该对话能继续用。
CHAT_RUN_STALE_TIMEOUT_SECONDS=1800

# ── 雪花 ID ──────────────────────────────────────────────────────────
# 多实例部署时每实例设不同值（0-1023），保证全局不撞号。
SNOWFLAKE_WORKER_ID=0
